# HEBUZA web (Next.js). Copy to .env.local.
# Server base URL; /api/* is proxied there (same-origin cookies). Unset → MSW dummy data.
API_URL=http://localhost:4000
# The server's JWT public key (PEM, Ed25519) — lets the route guard verify sessions.
JWT_PUBLIC_KEY=
# Shared with the server: signs CMS revalidate hooks.
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# on = MSW dummy data; defaults to off when API_URL is set.
# NEXT_PUBLIC_API_MOCKING=off
